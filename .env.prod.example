# ==========================================
# PAYFLOW AI - PRODUCTION ENVIRONMENT TEMPLATE
# ==========================================

# ------------------------------------------
# POSTGRESQL
# ------------------------------------------
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# ------------------------------------------
# JWT SECURITY
# ------------------------------------------
JWT_SECRET=CHANGE_ME_USE_A_SECURE_RANDOM_SECRET
JWT_EXPIRATION=3600000

# ------------------------------------------
# REDIS AUTHENTICATION
# ------------------------------------------
REDIS_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Must contain the SAME password as REDIS_PASSWORD.
# Use a URL-safe password (hexadecimal recommended).
REDIS_URL=redis://:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@redis:6379

# ------------------------------------------
# OLLAMA / LOCAL AI MODEL
# ------------------------------------------
OLLAMA_MODEL=llama3.2:3b

# ------------------------------------------
# CORS
# ------------------------------------------
# Replace with your actual frontend origin.
# Example: https://payflow.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example